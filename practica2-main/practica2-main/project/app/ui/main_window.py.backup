class LoginDialog(QDialog):
    """Login dialog based on the provided UI mockup."""

    def __init__(self) -> None:
        """Initialize the login dialog."""
        super().__init__()

        self.settings = QSettings("JKHApp", "MonitoringExpenses")
        self.user_name = self.settings.value("user/name", "", type=str)

        self.setWindowTitle("Мониторинг расходов ЖКХ")
        self.setFixedSize(560, 620)

        self.setStyleSheet(
            """
            QDialog {
                background: #f5f7fa;
            }

            QFrame#loginCard {
                background: white;
                border: 1px solid #111827;
                border-radius: 18px;
            }

            QLabel#loginTitle {
                color: #111827;
                font-size: 21px;
                font-weight: 700;
            }

            QLabel#loginSubtitle {
                color: #6b7b9a;
                font-size: 14px;
            }

            QLabel {
                color: #111827;
            }

            QLineEdit {
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                padding: 10px;
                background: white;
            }

            QPushButton {
                background: #203f91;
                color: white;
                border: none;
                border-radius: 6px;
                padding: 10px;
                font-size: 14px;
            }

            QPushButton:hover {
                background: #172d68;
            }

            QPushButton#secondary {
                background: white;
                color: #203f91;
                border: 1px solid #203f91;
            }

            QLabel#link {
                color: #203f91;
            }
            """
        )

        outer_layout = QVBoxLayout(self)
        outer_layout.setContentsMargins(60, 38, 60, 38)

        card = QFrame()
        card.setObjectName("loginCard")

        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(42, 30, 42, 28)
        card_layout.setSpacing(10)

        title = QLabel("Мониторинг расходов ЖКХ")
        title.setObjectName("loginTitle")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)

        subtitle = QLabel("Вход в систему")
        subtitle.setObjectName("loginSubtitle")
        subtitle.setAlignment(Qt.AlignmentFlag.AlignCenter)

        card_layout.addWidget(title)
        card_layout.addSpacing(8)
        card_layout.addWidget(subtitle)
        card_layout.addSpacing(15)
        name_label = QLabel("Ваше имя")

        self.name_input = QLineEdit()
        self.name_input.setPlaceholderText("Введите ваше имя")
        self.name_input.setText(self.user_name)

        card_layout.addWidget(name_label)
        card_layout.addWidget(self.name_input)

        login_label = QLabel("Логин")
        self.login_input = QLineEdit()
        self.login_input.setPlaceholderText("Введите логин")

        password_label = QLabel("Пароль")
        self.password_input = QLineEdit()
        self.password_input.setPlaceholderText("Введите пароль")
        self.password_input.setEchoMode(
            QLineEdit.EchoMode.Password
        )

        card_layout.addWidget(login_label)
        card_layout.addWidget(self.login_input)
        card_layout.addWidget(password_label)
        card_layout.addWidget(self.password_input)

        card_layout.addSpacing(15)

        registration_button = QPushButton("Регистрация")
        registration_button.setObjectName("secondary")
        registration_button.clicked.connect(self._registration)

        login_button = QPushButton("Войти в аккаунт")
        login_button.clicked.connect(self._login)

        or_label = QLabel("Или")
        or_label.setAlignment(Qt.AlignmentFlag.AlignCenter)

        gosuslugi_button = QPushButton("Войти через гос.услуги")
        gosuslugi_button.clicked.connect(self._gosuslugi)

        card_layout.addWidget(registration_button)
        card_layout.addSpacing(12)
        card_layout.addWidget(login_button)
        card_layout.addWidget(or_label)
        card_layout.addWidget(gosuslugi_button)

        outer_layout.addStretch()
        outer_layout.addWidget(card)
        outer_layout.addStretch()

        self.login_input.setText("demo")
        self.password_input.setText("demo")

    def _login(self) -> None:
        """Validate demo credentials."""
        login = self.login_input.text().strip()
        password = self.password_input.text()

        if login == "demo" and password == "demo":
            name = self.name_input.text().strip()

            if not name:
                QMessageBox.warning(
                    self,
                    "Не указано имя",
                    "Введите ваше имя перед входом.",
                )
                return

            self.user_name = name
            self.settings.setValue("user/name", name)
            self.settings.sync()

            self.accept()
            return

        QMessageBox.warning(
            self,
            "Ошибка входа",
            "Для демонстрационного режима используйте:\n\n"
            "Логин: demo\n"
            "Пароль: demo",
        )

    def _registration(self) -> None:
        """Show registration information."""
        QMessageBox.information(
            self,
            "Регистрация",
            "Форма регистрации будет подключена к базе данных "
            "на следующем этапе.",
        )

    def _gosuslugi(self) -> None:
        """Show the external authorization information."""
        QMessageBox.information(
            self,
            "Госуслуги",
            "Демонстрационная кнопка авторизации через Госуслуги.",
        )


class DonutChart(QWidget):
    """Simple donut chart for analytics."""

    def __init__(self, parent: QWidget | None = None) -> None:
        """Initialize the chart."""
        super().__init__(parent)
        self.setMinimumSize(330, 300)

    def paintEvent(self, event) -> None:
        """Paint the donut chart."""
        del event

        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        values = [
            (20, QColor("#718096")),
            (25, QColor("#2955d9")),
            (55, QColor("#ffc400")),
        ]

        total = sum(value for value, _ in values)

        center = QPointF(
            self.width() * 0.42,
            self.height() * 0.50,
        )

        radius = min(self.width(), self.height()) * 0.30
        width = radius * 0.30

        start_angle = -90.0

        for value, color in values:
            span_angle = 360.0 * value / total

            pen = QPen(color)
            pen.setWidthF(width)
            pen.setCapStyle(Qt.PenCapStyle.Round)

            painter.setPen(pen)
            painter.drawArc(
                int(center.x() - radius),
                int(center.y() - radius),
                int(radius * 2),
                int(radius * 2),
                int(-start_angle * 16),
                int(-span_angle * 16),
            )

            start_angle += span_angle

        painter.end()


class ResourceBars(QWidget):
    """Display monthly resource consumption bars."""

    def __init__(self, parent: QWidget | None = None) -> None:
        """Initialize the resource chart."""
        super().__init__(parent)
        self.setMinimumHeight(270)

    def paintEvent(self, event) -> None:
        """Paint monthly resource bars."""
        del event

        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        months = ["Май", "Июнь", "Июль", "Август", "Сентябрь"]
        values = [70, 95, 25, 25, 98]
        colors = [
            QColor("#29458f"),
            QColor("#ffc400"),
            QColor("#9aa8bd"),
            QColor("#9aa8bd"),
            QColor("#ffc400"),
        ]

        chart_left = 30
        chart_right = self.width() - 30
        chart_bottom = self.height() - 48
        chart_top = 30

        available_width = chart_right - chart_left
        gap = available_width / len(months)

        for index, month in enumerate(months):
            bar_width = 18
            x = chart_left + gap * index + gap / 2 - bar_width / 2

            height = (
                values[index]
                / 100
                * (chart_bottom - chart_top)
            )

            painter.setBrush(QBrush(colors[index]))
            painter.setPen(Qt.PenStyle.NoPen)

            painter.drawRoundedRect(
                int(x),
                int(chart_bottom - height),
                bar_width,
                int(height),
                5,
                5,
            )

            painter.setPen(QPen(QColor(TEXT)))
            painter.setFont(QFont("Arial", 10))

            text_rect = painter.boundingRect(
                int(x - 20),
                chart_bottom + 10,
                60,
                25,
                Qt.AlignmentFlag.AlignCenter,
                month,
            )

            painter.drawText(text_rect, month)

        painter.end()


class MainWindow(QMainWindow):
    """Main application window matching the supplied mockups."""

    page_changed = Signal(int)

    def __init__(self, user_name: str) -> None:
        """Initialize the main window."""
        super().__init__()

        self.user_name = user_name

        # Банковские карты хранятся в памяти приложения.
        self.bank_cards: list[dict[str, object]] = [
            {"bank": "СберБанк", "number": "0000 0000 0000 0000", "expiry": "00/00", "main": True},
            {"bank": "ВТБ", "number": "0000 0000 0000 0000", "expiry": "00/00", "main": False},
        ]

        self.setWindowTitle("Мониторинг расходов ЖКХ")
        self.resize(1440, 900)
        self.setMinimumSize(1100, 700)

        self._apply_style()

        self.stack = QStackedWidget()

        self.nav_buttons: list[QPushButton] = []

        self._build_layout()
        self._create_pages()
        self.current_property_id = 1
        self._load_meters()

        self._set_active_navigation(0)

