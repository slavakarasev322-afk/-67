            }

            QLabel#pageTitle {
                font-size: 21px;
                font-weight: 700;
            }

            QLabel#cardTitle {
                font-weight: 700;
            }

            QLabel#bigValue {
                font-size: 28px;
                font-weight: 700;
            }

            QLabel#redValue {
                color: #ff4b4b;
                font-size: 28px;
                font-weight: 700;
            }

            QLabel#greenValue {
                color: #00b979;
                font-size: 18px;
                font-weight: 700;
            }

            QFrame#card {
                background: white;
                border: none;
                border-radius: 8px;
            }

            QFrame#whitePanel {
                background: white;
                border-radius: 8px;
            }

            QLineEdit,
            QComboBox {
                background: white;
                border: 1px solid #d1d5db;
                border-radius: 5px;
                padding: 8px;
            }

            QPushButton#primaryButton {
                background: #203f91;
                color: white;
                border: none;
                border-radius: 3px;
                padding: 10px 18px;
                font-weight: 700;
            }

            QPushButton#primaryButton:hover {
                background: #172d68;
            }

            QPushButton#outlineButton {
                background: white;
                color: #111827;
                border: 1px solid #111827;
