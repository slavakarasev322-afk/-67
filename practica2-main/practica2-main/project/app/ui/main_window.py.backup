                border: none;
                background: transparent;
            }

            QCheckBox {
                spacing: 10px;
                font-weight: 600;
            }
            """
        )

    def _build_layout(self) -> None:
        """Build the main window layout."""
        central = QWidget()
        central_layout = QHBoxLayout(central)
        central_layout.setContentsMargins(0, 0, 0, 0)
        central_layout.setSpacing(0)

        sidebar = self._create_sidebar()
        central_layout.addWidget(sidebar)

        content = QWidget()
        content.setObjectName("content")

        content_layout = QVBoxLayout(content)
        content_layout.setContentsMargins(0, 0, 0, 0)
        content_layout.setSpacing(0)

        top_bar = self._create_top_bar()
        content_layout.addWidget(top_bar)

        content_layout.addWidget(self.stack, 1)

        central_layout.addWidget(content, 1)

        self.setCentralWidget(central)

    def _create_sidebar(self) -> QWidget:
        """Create the pink navigation sidebar."""
        sidebar = QWidget()
        sidebar.setObjectName("sidebar")
        sidebar.setFixedWidth(196)

        layout = QVBoxLayout(sidebar)
        layout.setContentsMargins(0, 28, 0, 0)
        layout.setSpacing(4)

        user_label = QLabel(self.user_name)
        user_label.setObjectName("userName")
        user_label.setContentsMargins(24, 0, 8, 0)

        role_label = QLabel("Роль: Владелец")
        role_label.setObjectName("roleLabel")
        role_label.setContentsMargins(24, 8, 8, 18)

        layout.addWidget(user_label)
        layout.addWidget(role_label)

        navigation = [
            ("Главное меню", 0),
            ("Приборы учета", 1),
            ("Аналитика и прогнозы", 2),
            ("Отчеты и экспорт", 3),
            ("Настройки", 4),
        ]

        for title, index in navigation:
            button = QPushButton(title)
            button.setObjectName("navButton")
            button.setProperty("active", False)
            button.clicked.connect(
                lambda checked=False, value=index: self._navigate(value)
            )

            self.nav_buttons.append(button)
            layout.addWidget(button)

        layout.addStretch()

        return sidebar

    
def _create_top_bar(self) -> QWidget:
    """Create the address selector and reading button."""
    top_bar = QWidget()
    top_bar.setObjectName("topBar")
    top_bar.setFixedHeight(64)

    layout = QHBoxLayout(top_bar)
    layout.setContentsMargins(26, 0, 26, 0)
    layout.setSpacing(12)

    self.address_combo = QComboBox()
    self.address_combo.setFixedWidth(420)

    try:
        for prop in list_properties():
            self.address_combo.addItem(
                prop["address"],
                int(prop["id"]),
            )
    except Exception as error:
        QMessageBox.warning(
            self,
            "Ошибка загрузки адресов",
            str(error),
        )

    self.address_combo.currentIndexChanged.connect(
        self._on_property_changed
    )

    layout.addWidget(self.address_combo)
    layout.addStretch()

    reading_button = QPushButton("+ Внести показания")
    reading_button.setObjectName("primaryButton")
    reading_button.clicked.connect(self._open_reading_dialog)
    layout.addWidget(reading_button)

    return top_bar


def _on_property_changed(self, index: int) -> None:
    """Update meters and readings after selecting another address."""
    property_id = self.address_combo.itemData(index)

    if property_id is None:
        self.current_property_id = None
        return

    self.current_property_id = int(property_id)
    self._load_meters()


def _reload_property_selector(
    self,
    selected_property_id: int | None = None,
) -> None:
    """Reload addresses after adding a new property."""
    properties = list_properties()

    self.address_combo.blockSignals(True)
    self.address_combo.clear()

    for prop in properties:
        self.address_combo.addItem(
            prop["address"],
            int(prop["id"]),
        )

    if selected_property_id is not None:
        index = self.address_combo.findData(selected_property_id)
    else:
        index = 0 if properties else -1

    if index >= 0:
        self.address_combo.setCurrentIndex(index)

    self.address_combo.blockSignals(False)

    current_id = self.address_combo.currentData()
    self.current_property_id = (
        int(current_id) if current_id is not None else None
    )

    # Не обращаемся к таблицам интерфейса, пока страницы не созданы.
    if (
        self.current_property_id is not None
        and hasattr(self, "meter_cards_layout")
        and hasattr(self, "history_table")
    ):
        self._load_meters()

    def _create_pages(self) -> None:
        """Create all main application pages."""
        self.stack.addWidget(self._dashboard_page())
        self.stack.addWidget(self._meters_page())
        self.stack.addWidget(self._analytics_page())
        self.stack.addWidget(self._reports_page())
        self.stack.addWidget(self._settings_page())

    def _create_top_bar(self) -> QWidget:
        """Create the apartment selector and reading button."""
        top_bar = QWidget()
        top_bar.setObjectName("topBar")
        top_bar.setFixedHeight(64)

        layout = QHBoxLayout(top_bar)
        layout.setContentsMargins(26, 0, 26, 0)

        apartment = QComboBox()
        apartment.setFixedWidth(340)
        apartment.addItem(
            "Квартира: г. Новосибирск, ул. Ленина 14"
        )
        apartment.addItem(
            "Квартира: г. Новосибирск, ул. Ленина 15"
        )

        layout.addWidget(apartment)
        layout.addStretch()

        reading_button = QPushButton("+ Внести показания")
        reading_button.setObjectName("primaryButton")
        reading_button.clicked.connect(self._open_reading_dialog)

        layout.addWidget(reading_button)

        return top_bar

    def _navigate(self, index: int) -> None:
        """Navigate to an application page."""
        self.stack.setCurrentIndex(index)
        self._set_active_navigation(index)

        if index == 1:
            self._load_meters()

    def _set_active_navigation(self, index: int) -> None:
        """Highlight the active navigation button."""
        for button_index, button in enumerate(self.nav_buttons):
            button.setProperty(
                "active",
                button_index == index,
            )
            button.style().unpolish(button)
            button.style().polish(button)

    def _dashboard_page(self) -> QWidget:
        """Create the dashboard page."""
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(8, 0, 24, 24)
        layout.setSpacing(10)

        cards_layout = QHBoxLayout()
        cards_layout.setSpacing(16)

        cards_layout.addWidget(
            self._stat_card(
                "К оплате за сентябрь",
                "4 800,50₽",
                "red",
            )
        )

        cards_layout.addWidget(
            self._stat_card(
                "Месячный бюджет ЖКХ",
                "5 500₽",
                "normal",
            )
        )

        cards_layout.addWidget(
            self._stat_card(
                "Технический контроль",
                "Счетчики проверены",
                "green",
            )
        )

        layout.addLayout(cards_layout)

        chart_panel = QFrame()
        chart_panel.setObjectName("whitePanel")

        chart_layout = QVBoxLayout(chart_panel)
        chart_layout.setContentsMargins(26, 26, 26, 20)

        chart_title = QLabel(
            "Динамика потребления ресурсов "
            "(май - сентябрь 2026)"
        )
        chart_title.setStyleSheet(
            "font-size: 17px; font-weight: 700;"
        )

        chart_layout.addWidget(chart_title)

        chart = ResourceBars()
        chart_layout.addWidget(chart)

        legend = QHBoxLayout()

        legend.addStretch()

        for text, color in [
            ("Газ", "#8392aa"),
            ("Электро", "#ffc400"),
            ("Вода", "#29458f"),
        ]:
            button = QLabel(text)
            button.setAlignment(Qt.AlignmentFlag.AlignCenter)
            button.setFixedSize(66, 40)
            button.setStyleSheet(
                f"""
                background: {color};
                color: white;
                border-radius: 20px;
                font-weight: 700;
                """
            )
            legend.addWidget(button)

        legend.addStretch()

        chart_layout.addLayout(legend)

        layout.addWidget(chart_panel, 1)

        return page

    def _stat_card(
        self,
        title: str,
        value: str,
        value_type: str,
    ) -> QFrame:
        """Create a dashboard statistic card."""
        card = QFrame()
        card.setObjectName("card")
        card.setMinimumHeight(96)

        layout = QVBoxLayout(card)
        layout.setContentsMargins(16, 16, 16, 16)

        title_label = QLabel(title)
        title_label.setObjectName("cardTitle")

        value_label = QLabel(value)

        if value_type == "red":
            value_label.setObjectName("redValue")
        elif value_type == "green":
            value_label.setObjectName("greenValue")
        else:
            value_label.setObjectName("bigValue")

        layout.addWidget(title_label)
        layout.addWidget(value_label)

        return card

    def _meters_page(self) -> QWidget:
        """Create the meters and history page."""
        page = QWidget()

        outer = QVBoxLayout(page)
        outer.setContentsMargins(8, 0, 24, 20)

        meters_panel = QFrame()
        meters_panel.setObjectName("whitePanel")

        meters_layout = QVBoxLayout(meters_panel)
        meters_layout.setContentsMargins(20, 18, 20, 18)

        cards_layout = QHBoxLayout()

        self.meter_cards_layout = cards_layout

        meters_layout.addLayout(cards_layout)
        add_meter_button = QPushButton("+ Добавить прибор учета")
        add_meter_button.setObjectName("primaryButton")
        add_meter_button.clicked.connect(self._open_meter_dialog)
        meters_layout.addWidget(add_meter_button)

        outer.addWidget(meters_panel)

        history_panel = QFrame()
        history_panel.setObjectName("whitePanel")

        history_layout = QVBoxLayout(history_panel)
        history_layout.setContentsMargins(20, 20, 20, 10)

        title = QLabel("История показаний и расчетов")
        title.setStyleSheet(
            "font-size: 17px; font-weight: 700;"
        )

        history_layout.addWidget(title)

        self.history_table = QTableWidget()
        self.history_table.setColumnCount(6)
        self.history_table.setHorizontalHeaderLabels(
            [
                "Дата внесения",
                "Прибор учета",
                "Показания",
                "Расход",
                "Сумма",
                "Статус",
            ]
        )

        self.history_table.setSelectionBehavior(
            QTableWidget.SelectionBehavior.SelectRows
        )
        self.history_table.setEditTriggers(
            QTableWidget.EditTrigger.NoEditTriggers
        )

        history_layout.addWidget(self.history_table)

        pagination = QLabel("←      Страница 1 из 12      →")
        pagination.setAlignment(Qt.AlignmentFlag.AlignCenter)
        pagination.setStyleSheet(
            "padding: 16px; color: #111827;"
        )

        history_layout.addWidget(pagination)

        outer.addWidget(history_panel, 1)

        return page

    def _meter_card(
        self,
        resource: str,
        serial: str,
        verification: str,
    ) -> QFrame:
        """Create a meter summary card."""
        card = QFrame()
        card.setObjectName("card")
        card.setMinimumHeight(90)

        layout = QVBoxLayout(card)
        layout.setContentsMargins(8, 8, 8, 8)

        resource_label = QLabel(resource)
        resource_label.setStyleSheet(
            "font-size: 15px; font-weight: 700;"
        )

        serial_label = QLabel(f"СН: {serial}")
        serial_label.setStyleSheet(
            "color: #61718f; font-weight: 600;"
        )

        verification_label = QLabel(
            f"Поверка: {verification or 'не указана'}"
        )
        verification_label.setStyleSheet(
            "color: #00b979; font-weight: 700;"
        )

        layout.addWidget(resource_label)
        layout.addWidget(serial_label)
        layout.addWidget(verification_label)

        return card


    
def _open_meter_dialog(self) -> None:
    """Add a meter to the currently selected property."""
    if self.current_property_id is None:
        QMessageBox.warning(
            self,
            "Нет адреса",
            "Сначала добавьте или выберите адрес.",
        )
        return

    dialog = QDialog(self)
    dialog.setWindowTitle("Добавить прибор учета")
    dialog.resize(420, 300)

    layout = QVBoxLayout(dialog)
    form = QFormLayout()

    meter_type = QComboBox()
    meter_type.addItems([
        "Холодная вода",
        "Горячая вода",
        "Электричество",
        "Газ",
    ])

    serial_input = QLineEdit()
    serial_input.setPlaceholderText("Серийный номер")

    verification_input = QLineEdit()
    verification_input.setPlaceholderText("ГГГГ-ММ-ДД")

    form.addRow("Тип прибора:", meter_type)
    form.addRow("Серийный номер:", serial_input)
    form.addRow("Дата поверки:", verification_input)
    layout.addLayout(form)

    buttons = QDialogButtonBox(
        QDialogButtonBox.StandardButton.Save
        | QDialogButtonBox.StandardButton.Cancel
    )
    buttons.rejected.connect(dialog.reject)
    layout.addWidget(buttons)

    def save_meter() -> None:
        try:
            create_meter(
                meter_type.currentText(),
                serial_input.text(),
                verification_input.text(),
                self.current_property_id,
            )

            dialog.accept()
            self._load_meters()

            QMessageBox.information(
                self,
                "Готово",
                "Прибор учета сохранён для выбранного адреса.",
            )
        except Exception as error:
            QMessageBox.warning(
                dialog,
                "Ошибка",
                str(error),
            )

    buttons.accepted.connect(save_meter)
    dialog.exec()

    def _load_meters(self) -> None:
        """Refresh meter cards and reading history."""
        meters = list_meters(
            self.current_property_id
        )

        while self.meter_cards_layout.count():
            item = self.meter_cards_layout.takeAt(0)

            if item.widget():
                item.widget().deleteLater()

        resource_names = {
            "Холодная вода": "Холодное водоснабжение(ХВС)",
            "Горячая вода": "Горячее водоснабжение (ГВС)",
            "Электроэнергия": "Электроэнергия",
            "Газ": "Газ",
        }

        if not meters:
           
            resource_names = {
                "Холодная вода": "Холодное водоснабжение (ХВС)",
                "Горячая вода": "Горячее водоснабжение (ГВС)",
                "Электричество": "Электроэнергия",
                "Электроэнергия": "Электроэнергия",
                "Газ": "Газ",
}

            if not meters:
                empty_label = QLabel(
                    "Для выбранного адреса пока нет приборов учета."
                )
                empty_label.setStyleSheet(
                    "color: #6b7280; padding: 20px; font-weight: 600;"
                )
                self.meter_cards_layout.addWidget(empty_label)
            else:
                for meter in meters:
                    resource = resource_names.get(
                        meter["meter_type"],
                        meter["meter_type"],
                    )

                    self.meter_cards_layout.addWidget(
                        self._meter_card(
                            resource,
                            meter["serial_number"],
                            meter["verification_date"] or "",
                        )
                    )

            self.meter_cards_layout.addStretch()
            self._load_history()

    def _load_history(self) -> None:
        """Load meter history into the table."""
        readings = list_readings(
            self.current_property_id
        )

        self.history_table.setRowCount(0)

        for reading in readings:
            row = self.history_table.rowCount()
            self.history_table.insertRow(row)

            resource = reading["meter_type"]
            value = reading["reading_value"]
            previous = reading["previous_value"]
            consumption = reading["consumption"]

            amount = (
                float(consumption or 0) * 4.20
            )

            status = "Оплачено" if row % 2 else "Долг"

            values = [
                str(reading["reading_date"])[:10],
                resource,
                f"{value:g}",
                f"{consumption or 0:g}",
                f"{amount:.2f} ₽",
                status,
            ]

            for column, value_text in enumerate(values):
                item = QTableWidgetItem(value_text)

                if column == 5:
                    if status == "Оплачено":
                        item.setForeground(
                            QColor("#00a86b")
                        )
                    else:
                        item.setForeground(
                            QColor("#ff4b4b")
                        )

                self.history_table.setItem(
                    row,
                    column,
                    item,
                )

        self.history_table.resizeColumnsToContents()

