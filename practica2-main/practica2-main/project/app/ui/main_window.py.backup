            }

            QPushButton#settingButton {
                background: #dbe2f0;
                border: none;
                border-radius: 5px;
                padding: 10px 14px;
                text-align: left;
                font-weight: 700;
            }

            QPushButton#settingButton:hover {
                background: #cbd5e1;
            }

            QTableWidget {
                background: white;
                border: none;
                gridline-color: #eeeeee;
                font-size: 14px;
            }

            QHeaderView::section {
                background: white;
                border: none;
