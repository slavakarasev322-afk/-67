    def _settings_page(self) -> QWidget:
        """Create the settings page with functional sections."""
        page = QWidget()

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)

        container = QWidget()
        layout = QVBoxLayout(container)
        layout.setContentsMargins(8, 0, 24, 30)
        layout.setSpacing(12)

        title = QLabel("Настройки")
        title.setObjectName("pageTitle")
        layout.addWidget(title)

        subtitle = QLabel(
            "Профиль, безопасность, жильё, уведомления и банковские карты"
        )
        subtitle.setStyleSheet("color: #6b7280;")
        layout.addWidget(subtitle)

        settings = [
            ("👤", "Профиль и аккаунт", "Изменение имени, телефона и email",
             self._profile_dialog),
            ("🛡", "Безопасность", "Пароль, 2FA и подключённые устройства",
             self._security_dialog),
            ("🏠", "Выбор жилья", "Адреса объектов недвижимости и основной объект",
             self._property_dialog),
            ("🔔", "Настройка уведомлений", "Каналы и типы уведомлений",
             self._notification_dialog),
            ("💳", "Банковские карты", "Добавление, просмотр и удаление карт",
             self._bank_cards_dialog),
        ]

        for icon, title_text, description, callback in settings:
            card = QFrame()
            card.setObjectName("whitePanel")
            card_layout = QHBoxLayout(card)
            card_layout.setContentsMargins(18, 14, 18, 14)
            card_layout.setSpacing(16)

            icon_label = QLabel(icon)
            icon_label.setFixedWidth(34)
            icon_label.setStyleSheet("font-size: 24px;")

            text_layout = QVBoxLayout()
            text_layout.setSpacing(3)
            name_label = QLabel(title_text)
            name_label.setStyleSheet(
                "font-size: 16px; font-weight: 700;"
            )
            desc_label = QLabel(description)
            desc_label.setStyleSheet("color: #6b7280;")
            text_layout.addWidget(name_label)
            text_layout.addWidget(desc_label)

            button = QPushButton("Открыть")
            button.setObjectName("primaryButton")
            button.setFixedWidth(110)
            button.clicked.connect(callback)

            card_layout.addWidget(icon_label)
            card_layout.addLayout(text_layout, 1)
            card_layout.addWidget(button)
            layout.addWidget(card)

        layout.addStretch()
        scroll.setWidget(container)

        page_layout = QVBoxLayout(page)
        page_layout.setContentsMargins(0, 0, 0, 0)
        page_layout.addWidget(scroll)
        return page

    def _open_settings_form(
        self,
        title: str,
        fields: list[tuple[str, str]],
    ) -> None:
        """Open a reusable settings dialog."""
        dialog = QDialog(self)
        dialog.setWindowTitle(title)
        dialog.resize(500, 320)

        layout = QVBoxLayout(dialog)
        form = QFormLayout()
        inputs: list[QLineEdit] = []

        for label, value in fields:
            field = QLineEdit(value)
            form.addRow(label, field)
            inputs.append(field)

        layout.addLayout(form)

        buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Save
            | QDialogButtonBox.StandardButton.Cancel
        )
        buttons.accepted.connect(dialog.accept)
        buttons.rejected.connect(dialog.reject)
        layout.addWidget(buttons)
        dialog.exec()

